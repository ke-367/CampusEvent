[Unit]
Description=CampusEvent 校园活动报名与管理系统
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/campus-event
Environment=CAMPUS_ADMIN_CODE=admin123
Environment=CAMPUS_SECRET_KEY=please-change-this-in-production
ExecStart=/opt/campus-event/.venv/bin/waitress-serve --listen=127.0.0.1:8000 --threads=8 run:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
